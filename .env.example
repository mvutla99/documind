# Copy to .env and fill in.  cp .env.example .env

# "demo" = offline, no key needed.  "gemini" = real embeddings + LLM.
PROVIDER=demo
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
TEMPERATURE=0.2

DATA_DIR=data
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# MIN_SCORE=0.3
MAX_UPLOAD_MB=20

# vector | bm25 | hybrid (vector + keyword search, fused with Reciprocal Rank Fusion)
RETRIEVAL_MODE=hybrid
RRF_K=60
BM25_MIN_COVERAGE=0.5

# Set to require an "X-API-Key" header on every API call.
API_KEY=
